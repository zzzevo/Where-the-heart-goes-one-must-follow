# Auto detect text files and perform LF normalization
* text=auto

# PowerShell scripts MUST be stored verbatim: they carry a UTF-8 BOM and
# Windows PowerShell 5.1 relies on that BOM to decode Chinese correctly.
# Disable any EOL / encoding conversion for them.
*.ps1 -text

# Docs use LF
*.md  text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.zip binary
*.tar binary
